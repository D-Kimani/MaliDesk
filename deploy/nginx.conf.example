server {
    listen 443 ssl http2;
    server_name malidesk.example.com;

    # Put your TLS certificate/key here. Use a managed certificate where possible.
    ssl_certificate /etc/letsencrypt/live/malidesk.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/malidesk.example.com/privkey.pem;

    root /var/www/malidesk/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://api:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
